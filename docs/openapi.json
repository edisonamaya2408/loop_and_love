  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT de acceso administrativo enviado como Authorization: Bearer <token>."
      }
    },
    "parameters": {
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "description": "Identificador entero del producto.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      },
      "CategoryPathId": {
        "name": "category_id",
        "in": "path",
        "required": true,
        "description": "Identificador entero de la categoría.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      },
      "Search": {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Texto de búsqueda del producto. Se limpia y normaliza en la capa de aplicación.",
        "schema": {
          "type": "string"
        }
      },
      "CategoryId": {
        "name": "category_id",
        "in": "query",
        "required": false,
        "description": "Filtra por ID de categoría. En el catálogo público la categoría debe estar activa.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      },
      "MinPrice": {
        "name": "min_price",
        "in": "query",
        "required": false,
        "description": "Precio mínimo. Admite como máximo dos decimales y no puede ser negativo.",
        "schema": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "example": "50000.00"
        }
      },
      "MaxPrice": {
        "name": "max_price",
        "in": "query",
        "required": false,
        "description": "Precio máximo. Admite como máximo dos decimales y no puede ser negativo.",
        "schema": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,2})?$",
          "example": "100000.00"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Número de página. Por defecto 1 y máximo 10000.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 10000,
          "default": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "description": "Cantidad de registros por página. Por defecto 12 y máximo 50.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 50,
          "default": 12
        }
      },
      "IsActive": {
        "name": "is_active",
        "in": "query",
        "required": false,
        "description": "Filtra por estado del producto.",
        "schema": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ]
        }
      }
