{
  "openapi": "3.0.3",
  "info": {
    "title": "Loop & Love API",
    "version": "1.0.0",
    "description": "Contrato OpenAPI de la API REST actualmente implementada por Loop & Love. La especificación refleja únicamente las rutas y comportamientos existentes en el backend."
  },
  "servers": [
    {
      "url": "https://loop-and-love-y5gj.onrender.com",
      "description": "Producción - Render"
    },
    {
      "url": "http://127.0.0.1:5000",
      "description": "Desarrollo local"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Comprobaciones de disponibilidad"
    },
    {
      "name": "Auth",
      "description": "Autenticación administrativa"
    },
    {
      "name": "Products",
      "description": "Catálogo público de productos"
    },
    {
      "name": "Categories",
      "description": "Catálogo público de categorías"
    },
    {
      "name": "Admin Products",
      "description": "Administración de productos"
    },
    {
      "name": "Admin Categories",
      "description": "Administración de categorías"
