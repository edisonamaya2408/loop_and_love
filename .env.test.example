# =========================================================
# Loop & Love - PostgreSQL Integration Test Environment
# =========================================================

# Application
APP_ENV=testing
FLASK_ENV=testing

# Flask
SECRET_KEY=change-this-secret-key

# PostgreSQL integration tests (optional for local development)
TEST_DATABASE_URL=

# JWT
JWT_SECRET_KEY=generate-a-secure-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# WhatsApp
WHATSAPP_NUMBER=

# CORS
CORS_ORIGINS=http://localhost:5000

# Storage
STORAGE_PROVIDER=auto

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=products

# Image uploads
MAX_IMAGE_SIZE_MB=5
MAX_UPLOAD_REQUEST_OVERHEAD_MB=1

# Logging
LOG_LEVEL=INFO

# Rate limiting
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_STRATEGY=sliding-window-counter
TRUSTED_PROXY_COUNT=0
